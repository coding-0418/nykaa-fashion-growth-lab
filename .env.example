# Local secrets — never commit real keys
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

# Search provider: brave | tavily | mock
# mock is labelled MOCK/DEMO and must not be used as real evidence.
SEARCH_PROVIDER=brave

# Brave Search API — required when SEARCH_PROVIDER=brave
# https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Tavily Search API — required when SEARCH_PROVIDER=tavily
# https://tavily.com/
TAVILY_API_KEY=

# Conservative retrieval limits (optional)
RETRIEVAL_MAX_QUERIES=6
RETRIEVAL_MAX_RESULTS_PER_QUERY=4
RETRIEVAL_MAX_PAGES_FETCHED=8
RETRIEVAL_TIMEOUT_MS=6000
RETRIEVAL_MAX_CONTENT_BYTES=400000

# AI cost / performance controls (optional)
AI_MAX_DOCUMENTS_SCREENED=8
AI_MAX_DOCUMENTS_EXTRACTED=5
AI_TIMEOUT_MS=20000
AI_RETRY_LIMIT=1
AI_CONCURRENCY=2
AI_REVIEW_CONFIDENCE_THRESHOLD=0.55
AI_PARTIAL_EXTRACT_MIN_CONFIDENCE=0.65
AI_MAX_SOURCE_CHARS=8000
